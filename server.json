{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/nullpointer-file-share",
    "description": "MCP server that uploads files to 0x0.st (nullpointer) for temporary file sharing",
    "version": "1.0.1",
    "icons": [
        {
            "src": "https://raw.githubusercontent.com/andreasjhagen/OpenAgent-MCPs/main/mcp-nullpointer-file-share/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/nullpointer-file-share",
            "version": "1.0.1",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": []
        }
    ],
    "repository": {
        "url": "https://github.com/andreasjhagen/OpenAgent-MCPs",
        "source": "github",
        "subfolder": "mcp-nullpointer-file-share"
    }
}
