{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/nullpointer-file-share",
    "description": "MCP server that uploads files to 0x0.st (nullpointer) for temporary file sharing",
    "version": "1.0.4",
    "icons": [
        {
            "src": "https://unpkg.com/@cynosure-mcp/nullpointer-file-share@1.0.4/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/nullpointer-file-share",
            "version": "1.0.4",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": []
        }
    ],
    "repository": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-nullpointer-file-share",
        "source": "github"
    }
}
