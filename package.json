{
  "name": "@cynosure-mcp/nullpointer-file-share",
  "mcpName": "io.github.andreasjhagen/nullpointer-file-share",
  "version": "1.0.4",
  "description": "MCP server that uploads files to 0x0.st (nullpointer) for temporary file sharing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nullpointer-file-share": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "release:check": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add server.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "server.json",
    "icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "file-sharing",
    "0x0",
    "upload",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-nullpointer-file-share.git"
  },
  "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-nullpointer-file-share#readme",
  "bugs": {
    "url": "https://github.com/Cynosure-MCP-Collection/mcp-nullpointer-file-share/issues"
  }
}
